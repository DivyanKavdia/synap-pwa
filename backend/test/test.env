# Fixture environment for `npm test`.
#
# The real service fails fast at boot when configuration is missing, which is
# the behaviour we want in production — a revision that cannot reach Secret
# Manager should never accept traffic. Unit tests still have to import those
# modules, so they get obviously-fake values here. Nothing in this file is a
# credential, and nothing in it reaches a network.
GOOGLE_CLOUD_PROJECT=synap-test
SYNAP_GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
SYNAP_AUDIO_BUCKET=synap-test-audio
SYNAP_GEMINI_API_KEY=test-not-a-real-key
SYNAP_SESSION_SIGNING_KEY=dGVzdC1zaWduaW5nLWtleS1mb3ItdW5pdC10ZXN0cy1vbmx5IQ==
SYNAP_DISABLE_VECTOR_INDEX=1

# Cloud coordination has dedicated fake-store/emulator tests.
SYNAP_SHARED_MODEL_COOLDOWN=0
