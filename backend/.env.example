# Copy to .env and use a development GCP project with Application Default Credentials.
GOOGLE_CLOUD_PROJECT=your-development-project
SYNAP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SYNAP_AUDIO_BUCKET=your-development-audio-bucket
SYNAP_ALLOWED_ORIGINS=http://localhost:4173
SYNAP_LOCATION=asia-south1
PORT=8080

# Existing Secret Manager names or full version resource paths.
SYNAP_GEMINI_API_KEY_SECRET=synap-gemini-api-key
SYNAP_SESSION_SIGNING_KEY_SECRET=synap-session-signing-key

# Match the deployed development resources in docs/GCP_DEPLOYMENT.md.
SYNAP_KMS_LOCATION=asia-south1
SYNAP_KMS_KEY_RING=synap
SYNAP_KMS_KEY_ID=user-kek
SYNAP_TASKS_LOCATION=asia-south1
SYNAP_TASKS_QUEUE=synap-processing
SYNAP_SERVICE_URL=
SYNAP_TASKS_INVOKER_SA=

# Optional private speaker service; blank leaves acoustic identification unavailable.
SYNAP_SPEAKER_SERVICE_URL=
